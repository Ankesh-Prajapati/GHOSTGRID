# GhostGrid is a static browser app and does not require private API keys.
# These values document the public data sources used by js/data.js.

GHOSTGRID_IPSUM_PRIMARY_URL=https://raw.githubusercontent.com/stamparm/ipsum/master/ipsum.txt
GHOSTGRID_IPSUM_FALLBACK_URL=https://cdn.jsdelivr.net/gh/stamparm/ipsum@master/ipsum.txt
GHOSTGRID_GEOJS_BATCH_URL=https://get.geojs.io/v1/ip/geo.json
GHOSTGRID_KEV_PRIMARY_URL=https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json
GHOSTGRID_KEV_FALLBACK_URL=https://cdn.jsdelivr.net/gh/cisagov/kev-data@develop/known_exploited_vulnerabilities.json

# Optional local development port for static file servers.
GHOSTGRID_LOCAL_PORT=8080
